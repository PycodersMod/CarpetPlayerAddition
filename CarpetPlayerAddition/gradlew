#!/usr/bin/env sh
set -e
GRADLE_VERSION=9.4.1
PROJECT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GRADLE_HOME="$PROJECT_DIR/.gradle/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  for candidate in "$HOME"/.gradle/wrapper/dists/gradle-$GRADLE_VERSION-bin/*/gradle-$GRADLE_VERSION/bin/gradle; do
    if [ -x "$candidate" ]; then
      GRADLE_BIN="$candidate"
      break
    fi
  done
fi
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$PROJECT_DIR/.gradle"
  ZIP="$PROJECT_DIR/.gradle/gradle.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -L "https://downloads.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP"
  else
    wget "https://downloads.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -O "$ZIP"
  fi
  unzip -o "$ZIP" -d "$PROJECT_DIR/.gradle" >/dev/null
fi
exec "$GRADLE_BIN" "$@"
