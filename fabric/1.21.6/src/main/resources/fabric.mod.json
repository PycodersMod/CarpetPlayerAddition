  "icon": "assets/carpet-player-addition/logo.png",
  "authors": ["Pycoder"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.pycoder.carpetplayeraddition.CarpetPlayerAddition"
    ],
    "client": [
      "com.pycoder.carpetplayeraddition.CarpetPlayerAdditionClient"
    ]
  },
  "mixins": [
    "carpet-player-addition.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.6",
    "fabric-api": ">=0.128.2+1.21.6",
    "carpet": ">=1.4.176"
  }
